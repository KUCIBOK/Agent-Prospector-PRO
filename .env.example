# ============================================================================
# KUCIBOK PROSPECTOR — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ============================================================================
# API & SERVER
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=database
DB_PORT=5432
DB_USER=kucibok
DB_PASSWORD=changeme
DB_NAME=kucibok_prospector
DATABASE_URL=postgresql://kucibok:changeme@database:5432/kucibok_prospector

# ============================================================================
# REDIS (Job Queue, Cache)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================================================
# AI / LLM (Ollama)
# ============================================================================
OLLAMA_HOST=http://ai:11434
MODEL_NAME=llama2
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# ============================================================================
# CELERY (Job Queue)
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================================================
# SCHEDULER (Cron Jobs)
# ============================================================================
SCHEDULER_ENABLED=true
DISCOVERY_SCHEDULE_HOUR=8
CRAWLING_SCHEDULE_HOUR=9
ENRICHMENT_SCHEDULE_HOUR=10
ANALYSIS_SCHEDULE_HOUR=11
SCORING_SCHEDULE_HOUR=12

# ============================================================================
# CRAWLER & DISCOVERY
# ============================================================================
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=Kucibok-Prospector/1.1 (+http://kucibok.com/bot)
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_FOLLOW_REDIRECTS=true

# ============================================================================
# DISCOVERY KEYWORDS & TARGETS
# ============================================================================
DISCOVERY_KEYWORDS_ARTISTS=contemporary African artist,emerging African artists,African sculptor
DISCOVERY_KEYWORDS_CURATORS=art advisor Africa,curator contemporary art,African art specialist
DISCOVERY_COUNTRIES=SN,CI,NG,KE,ZA,MA,EG,TZ

# ============================================================================
# OUTREACH ENGINE
# ============================================================================
OUTREACH_ENABLED=true
OUTREACH_MIN_PRIORITY=P2
OUTREACH_MIN_CONFIDENCE=MEDIUM
LINKEDIN_ACCOUNT_URL=https://www.linkedin.com/in/yourprofile

# ============================================================================
# ARTIST ONBOARDING (Instagram)
# ============================================================================
ARTIST_ONBOARDING_ENABLED=true
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-graph-api-token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
INSTAGRAM_API_VERSION=v18.0

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/app/backups

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/kucibok.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# SECURITY
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# EXTERNAL SERVICES (Optional, disabled by default)
# ============================================================================
# Use these only if you want to integrate paid services
# OPENAI_API_KEY=sk-xxx (alternative LLM, not used by default)
# CLEARBIT_API_KEY=xxx (enrichment service, optional)
# HUNTER_API_KEY=xxx (email finder, optional)
