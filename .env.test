# Test Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true
SECRET_KEY=test-secret-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=test
DB_PASSWORD=test
DB_NAME=test_db
DATABASE_URL=sqlite:///test.db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# AI
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama2
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Scheduler
SCHEDULER_ENABLED=false
DISCOVERY_SCHEDULE_HOUR=8
CRAWLING_SCHEDULE_HOUR=9
ENRICHMENT_SCHEDULE_HOUR=10
ANALYSIS_SCHEDULE_HOUR=11
SCORING_SCHEDULE_HOUR=12

# Crawler
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=Kucibok-Test/1.0
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_FOLLOW_REDIRECTS=true

# Discovery
DISCOVERY_KEYWORDS_ARTISTS=artist,sculptor
DISCOVERY_KEYWORDS_CURATORS=curator,advisor
DISCOVERY_COUNTRIES=SN,NG,KE

# Outreach
OUTREACH_ENABLED=true
OUTREACH_MIN_PRIORITY=P2
OUTREACH_MIN_CONFIDENCE=MEDIUM

# Artist Onboarding
ARTIST_ONBOARDING_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=test
INSTAGRAM_ACCESS_TOKEN=test
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=test

# Backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=/tmp/test.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
