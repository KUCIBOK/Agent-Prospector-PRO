# API & SERVER
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
SECRET_KEY=IWBAKI0R_xY8Q8V8FQyzlXxl07BfhzuoAE9G-a553gs

# DATABASE (PostgreSQL)
# Update these with your production database credentials
DB_HOST=postgres.internal
DB_PORT=5432
DB_USER=kucibok
DB_PASSWORD=qrCQ-fJ4AejqG_r-DWHez-DBf94PxmkH
DB_NAME=kucibok_prospector
DATABASE_URL=postgresql+psycopg://kucibok:BatNz6h0CYbduIxKxYclcFP1mP5HetXf@dpg-da75bth5efls73c5cqug-a.frankfurt-postgres.render.com:5432/kucibok_prospector

# REDIS (Cache & Job Queue)
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_URL=redis://redis.internal:6379
REDIS_PASSWORD=

# AI / LLM (Ollama)
OLLAMA_HOST=http://ollama.internal:11434
MODEL_NAME=llama2
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# CELERY (Job Queue)
CELERY_BROKER_URL=redis://redis.internal:6379/0
CELERY_RESULT_BACKEND=redis://redis.internal:6379/1

# SCHEDULER (Cron Jobs)
SCHEDULER_ENABLED=true
DISCOVERY_SCHEDULE_HOUR=8
CRAWLING_SCHEDULE_HOUR=9
ENRICHMENT_SCHEDULE_HOUR=10
ANALYSIS_SCHEDULE_HOUR=11
SCORING_SCHEDULE_HOUR=12

# CRAWLER & DISCOVERY
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=Kucibok-Prospector/1.1 (+http://kucibok.com/bot)
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_FOLLOW_REDIRECTS=true

# DISCOVERY KEYWORDS & TARGETS
DISCOVERY_KEYWORDS_ARTISTS=contemporary African artist,emerging African artists,African sculptor
DISCOVERY_KEYWORDS_CURATORS=art advisor Africa,curator contemporary art,African art specialist
DISCOVERY_COUNTRIES=SN,CI,NG,KE,ZA,MA,EG,TZ

# OUTREACH ENGINE
OUTREACH_ENABLED=true
OUTREACH_MIN_PRIORITY=P2
OUTREACH_MIN_CONFIDENCE=MEDIUM
LINKEDIN_ACCOUNT_URL=https://www.linkedin.com/in/yourprofile

# ARTIST ONBOARDING (Instagram)
ARTIST_ONBOARDING_ENABLED=true
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-graph-api-token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
INSTAGRAM_API_VERSION=v18.0

# BACKUP & MAINTENANCE
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/app/backups

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=/var/log/kucibok/prospector.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# SECURITY
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================================
# 1. Replace all [YOUR_*] placeholders with actual values
# 2. Change DB_HOST, REDIS_HOST, OLLAMA_HOST to your internal hostnames
# 3. Update CORS_ORIGINS and ALLOWED_HOSTS with your domain
# 4. For Instagram, get tokens from Meta Business Platform
# 5. Set up SSL/TLS via reverse proxy (Nginx/Caddy)
# 6. Enable automated backups before going live
# 7. Configure monitoring and alerting
# ============================================================================
